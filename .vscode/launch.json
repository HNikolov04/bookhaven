{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BookHaven: API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "BookHaven: Build Backend",
      "program": "${workspaceFolder}/src/backend/BookHaven.Api/bin/Debug/net10.0/BookHaven.Api.dll",
      "cwd": "${workspaceFolder}/src/backend/BookHaven.Api",
      "launchSettingsProfile": "https",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
